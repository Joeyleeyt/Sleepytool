{
  "name": "@emberforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node --import tsx dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emberforge/core": "workspace:*",
    "@emberforge/db": "workspace:*",
    "@emberforge/queue": "workspace:*",
    "@emberforge/storage": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.8",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
