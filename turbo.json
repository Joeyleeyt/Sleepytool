{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "CI",
    "DATABASE_URL",
    "DB_POOL_MAX",
    "DB_CONNECT_TIMEOUT_S",
    "LLM_PROVIDER",
    "DISABLE_VEO3",
    "IMAGE_RATIO",
    "IMAGE_EVERY_N",
    "DEFAULT_VISUAL_TYPE",
    "SCENE_TARGET_S",
    "SHOT_MIN_S",
    "SHOT_MAX_S",
    "SHOT_PREF_S",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "GPT_KEY",
    "OPENAI_MODEL_OPUS",
    "OPENAI_MODEL_SONNET",
    "OPENAI_MODEL_HAIKU",
    "VEO3_API_KEY",
    "VEO3_BASE_URL",
    "LABS69_API_KEY",
    "LABS69_BASE_URL",
    "LABS69_VOICE_ID",
    "LABS69_VIDEO_MODEL",
    "LABS69_VIDEO_SEND_DURATION",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "REDIS_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "DEV_OWNER_ID",
    "FFMPEG_X264_PRESET",
    "FFMPEG_X264_CRF",
    "FFMPEG_NVENC_PRESET",
    "FFMPEG_NVENC_CQ",
    "FX_LIBRARY_DIR",
    "API_KEY_ENCRYPTION_SECRET",
    "LABS69_IMAGE_RESOLUTION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
