
# =========================================================================

LLM_PROVIDER=none

# DISABLE_VEO3: if "true", all cinematic_video shots route to 69labs video
# (use when you don't have Veo 3 access).
DISABLE_VEO3=true

# IMAGE_RATIO: fraction of shots that become `image_with_motion` (single 69labs
# image + Ken Burns). The rest become AI video clips (Veo 3 or 69labs.video).
# Default 0.2 → 20% images / 80% video clips. Enforced globally in BOTH the
# LLM-driven classify stage and the deterministic segment stage.
IMAGE_RATIO=0.2

# DEFAULT_VISUAL_TYPE: seed for the 80% video slots in LLM_PROVIDER=none mode.
# (The IMAGE_RATIO quota always forces the other 20% to image_with_motion.)
#   atmospheric_broll (default — 69labs video b-roll)
#   cinematic_video   (Veo 3 hero clips, or 69labs video if DISABLE_VEO3=true)
DEFAULT_VISUAL_TYPE=atmospheric_broll

# Deterministic shot pacing (only used when LLM_PROVIDER=none)
SCENE_TARGET_S=120
SHOT_MIN_S=5
SHOT_MAX_S=12
SHOT_PREF_S=8

# ===== TIMELINE PACING PATTERN =====
# Every narrated shot is a video "Clip". The builder inserts silent freeze-frame
# "Still" beats (frozen last frame of the preceding clip) between clips:
#   before PATTERN_SWITCH_S of timeline:  Clip Clip Still   (2 clips, 1 still)
#   after  PATTERN_SWITCH_S of timeline:  Clip Still Still  (1 clip, 2 stills)
# PATTERN_SWITCH_S is measured in accumulated timeline seconds. Default 1200 (20 min).
PATTERN_SWITCH_S=1200
# Each freeze still is held a random duration in [MIN, MAX] seconds.
FREEZE_STILL_MIN_S=3
FREEZE_STILL_MAX_S=4
# NOTE: for every Clip to be a true video clip (not an occasional Ken Burns
# still), set IMAGE_RATIO=0 so the classifier stops routing shots to images —
# the only stills then come from the freeze-frame pattern above.

# ===== PROVIDER KEYS =====

# Anthropic — only required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Google Veo 3 — only required when DISABLE_VEO3=false
VEO3_API_KEY=
VEO3_BASE_URL=placeholder

# 69labs.vip — REQUIRED (TTS, image, video, lipsync, enhance)
# LABS69_API_KEY is the FALLBACK key used when the api_keys table is empty (or
# for callers that don't go through the key manager, e.g. motion-graphics).
# For multi-key rotation, add keys to the api_keys table — via the /keys page in
# the web app, or `pnpm tsx scripts/keys.ts add <key>`. Workers try active keys
# in order and shift to the next on failure; add/remove keys without redeploying.
LABS69_API_KEY=placeholder
LABS69_BASE_URL=placeholder

# ----- 69labs API key pool (api_keys table) -----
# Master secret for AES-256-GCM encryption of stored keys. REQUIRED to use the
# api_keys table. 32 bytes — generate with: openssl rand -base64 32
# NEVER commit this; set it as a Vercel/Fly secret. A leaked DB dump is useless
# without it. Manage keys with: pnpm tsx scripts/keys.ts add|list|disable|rm
API_KEY_ENCRYPTION_SECRET=placeholder
# Your voice id from the 69labs dashboard. Used for all TTS narration.
LABS69_VOICE_ID=placeholder
# Optional: pin a specific 69labs video model. Leave blank to use the account's
# default (Veo 3.1 Lite as of writing).
LABS69_VIDEO_MODEL=
# Veo 3.1 Lite and several other models reject the `duration` field with 400.
# Leave false unless you've pinned LABS69_VIDEO_MODEL to one that accepts it.
LABS69_VIDEO_SEND_DURATION=false
# Image generation resolution for nano-banana models: 1k | 2k | 4k.
# Default 2k (~2048×1152) covers a Full HD 1920×1080 frame and downscales
# cleanly; 1k is sub-HD (upscaled), 4k is sharpest but costs the most.
# (Other image models — z-image, flux, gpt-image-2, grok — ignore this.)
LABS69_IMAGE_RESOLUTION=2k
# Max CONCURRENT in-flight 69labs jobs per kind (separate from req/min rate
# limits). Must match your 69labs plan's concurrent-job cap or you'll get
# `403 Concurrent ... limit reached`. Enforced by a distributed semaphore, so
# you can enqueue any number of prompts and they pipeline through N at a time.
LABS69_IMAGE_MAX_CONCURRENCY=4
LABS69_VIDEO_MAX_CONCURRENCY=4

# ===== INFRASTRUCTURE =====

# Postgres (REQUIRED) — Supabase.
# App runtime uses the TRANSACTION POOLER (port 6543) for tiny connection
# footprint. Migrations use the DIRECT connection (port 5432) — see README.
# URL-encode any special chars in the password (e.g. @ → %40).
DATABASE_URL=placeholder
# Optional: cap per-process Postgres connections. Default 5 (see packages/db/src/client.ts).
# DB_POOL_MAX=5

# Supabase platform features (Auth admin, Storage, Realtime). Server-only.
# Dashboard → Project Settings → API. SERVICE_ROLE_KEY bypasses RLS — never
# expose it to a browser. Drizzle queries don't need these; only code that
# calls `supabase()` from @emberforge/db does.
SUPABASE_URL=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder
# Public anon key for the web app (Next.js exposes vars prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder

# Redis (REQUIRED for BullMQ)
# Local dev: docker run -d -p 6379:6379 redis:7
REDIS_URL=placeholder 

# Cloudflare R2 (REQUIRED — persists every generated asset)
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET=placeholder

# ===== API =====
PORT=8080 
NODE_ENV=development
LOG_LEVEL=info

# Owner id assigned to every project created via the API (auth is off in safe-mode)
DEV_OWNER_ID=placeholder

# ===== RENDER =====
FFMPEG_PATH=placeholder
FFPROBE_PATH=placeholder
RENDER_WORK_DIR=placeholder

# NVENC: on a GPU machine with NVIDIA GPU, set to "true". Otherwise leave false.
NVENC_ENABLED=false

# FX overlays — if this folder is empty, the render worker silently skips overlays.
FX_LIBRARY_DIR=placeholder

# ----- Render performance knobs (all optional; sensible defaults shown) -----
# Recommended values for a performance-8x (8 vCPU) render machine are shown.
#
# Parallel per-shot FFmpeg processes. Default: min(8, ceil(cpuCount/2)).
# RENDER_SHOT_CONCURRENCY=8
# Parallel mix-segment prep (image Ken Burns encodes + video stream-copies).
# This is where render time is spent — set to the core count. Default: RENDER_SHOT_CONCURRENCY.
# RENDER_MIX_CONCURRENCY=8
# Parallel asset downloads during the composite prefetch (pure I/O). Default: 8.
# RENDER_DOWNLOAD_CONCURRENCY=16
# Threads PER intermediate image encode. With many parallel encodes, capping
# this (≈ cores / MIX_CONCURRENCY) stops libx264 oversubscribing the scheduler.
# Default: 2. Set 0 to let x264 auto-pick (one thread per core).
# FFMPEG_INTERMEDIATE_THREADS=2
# Preset/CRF for the image segment encodes (the master's final quality, since
# the final pass now stream-COPIES it — no second encode). Defaults: veryfast / 20.
# FFMPEG_INTERMEDIATE_PRESET=veryfast
# FFMPEG_INTERMEDIATE_CRF=20
# Ken Burns zoompan oversample factor. Lower = faster (zoompan is the hottest
# CPU filter). Must stay above the 1.15x max zoom. Default: 1.2.
# KENBURNS_OVERSAMPLE=1.2
#
# BURN_SUBTITLES: false (default) lets the final pass stream-copy the master and
# just mux audio — a ~2-hour render finishes the final step in seconds instead
# of a full re-encode. Set true ONLY if you need subtitles burned into the
# pixels (forces a full libx264 re-encode at FFMPEG_X264_PRESET/CRF below).
# BURN_SUBTITLES=false
# Preset/CRF for the FINAL encode — ONLY used when BURN_SUBTITLES=true. Defaults: medium / 20.
# FFMPEG_X264_PRESET=medium
# FFMPEG_X264_CRF=20

# ----- 69labs asset-generation concurrency -----
# NOTE: 69labs image and video now run on separate queues/workers (labsImage,
# labsVideo). Each worker's BullMQ concurrency is its per-kind cap above
# (LABS69_IMAGE_MAX_CONCURRENCY / LABS69_VIDEO_MAX_CONCURRENCY), so the old
# single combined LABS_CONCURRENCY knob is no longer read.
# Each active job buffers a download in memory, so peak RAM on the `workers`
# machine ≈ (IMAGE_MAX + VIDEO_MAX) × clip size — size the VM to match (see
# infra/fly/sleepytool.fly.toml). Raise the caps ONLY if you also bump RAM.
