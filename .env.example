
# =========================================================================

LLM_PROVIDER=none

# DISABLE_VEO3: if "true", all cinematic_video shots route to 69labs video
# (use when you don't have Veo 3 access).
DISABLE_VEO3=true

# IMAGE_RATIO: fraction of shots that become `image_with_motion` (single 69labs
# image + Ken Burns). The rest become AI video clips (Veo 3 or 69labs.video).
# Default 0.2 → 20% images / 80% video clips. Enforced globally in BOTH the
# LLM-driven classify stage and the deterministic segment stage.
IMAGE_RATIO=0.2

# DEFAULT_VISUAL_TYPE: seed for the 80% video slots in LLM_PROVIDER=none mode.
# (The IMAGE_RATIO quota always forces the other 20% to image_with_motion.)
#   atmospheric_broll (default — 69labs video b-roll)
#   cinematic_video   (Veo 3 hero clips, or 69labs video if DISABLE_VEO3=true)
DEFAULT_VISUAL_TYPE=atmospheric_broll

# Deterministic shot pacing (only used when LLM_PROVIDER=none)
SCENE_TARGET_S=120
SHOT_MIN_S=5
SHOT_MAX_S=12
SHOT_PREF_S=8

# ===== TIMELINE PACING PATTERN =====
# Every narrated shot is a video "Clip". The builder inserts silent freeze-frame
# "Still" beats (frozen last frame of the preceding clip) between clips:
#   before PATTERN_SWITCH_S of timeline:  Clip Clip Still   (2 clips, 1 still)
#   after  PATTERN_SWITCH_S of timeline:  Clip Still Still  (1 clip, 2 stills)
# PATTERN_SWITCH_S is measured in accumulated timeline seconds. Default 1200 (20 min).
PATTERN_SWITCH_S=1200
# Each freeze still is held a random duration in [MIN, MAX] seconds.
FREEZE_STILL_MIN_S=3
FREEZE_STILL_MAX_S=4
# NOTE: for every Clip to be a true video clip (not an occasional Ken Burns
# still), set IMAGE_RATIO=0 so the classifier stops routing shots to images —
# the only stills then come from the freeze-frame pattern above.

# ===== PROVIDER KEYS =====

# Anthropic — only required when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Google Veo 3 — only required when DISABLE_VEO3=false
VEO3_API_KEY=
VEO3_BASE_URL=placeholder

# 69labs.vip — REQUIRED (TTS, image, video, lipsync, enhance)
# LABS69_API_KEY is the FALLBACK key used when the api_keys table is empty (or
# for callers that don't go through the key manager, e.g. motion-graphics).
# For multi-key rotation, add keys to the api_keys table — via the /keys page in
# the web app, or `pnpm tsx scripts/keys.ts add <key>`. Workers try active keys
# in order and shift to the next on failure; add/remove keys without redeploying.
LABS69_API_KEY=placeholder
LABS69_BASE_URL=placeholder

# ----- 69labs API key pool (api_keys table) -----
# Master secret for AES-256-GCM encryption of stored keys. REQUIRED to use the
# api_keys table. 32 bytes — generate with: openssl rand -base64 32
# NEVER commit this; set it as a Vercel/Fly secret. A leaked DB dump is useless
# without it. Manage keys with: pnpm tsx scripts/keys.ts add|list|disable|rm
API_KEY_ENCRYPTION_SECRET=placeholder
# Your voice id from the 69labs dashboard. Used for all TTS narration.
LABS69_VOICE_ID=placeholder
# Optional: pin a specific 69labs video model. Leave blank to use the account's
# default (Veo 3.1 Lite as of writing).
LABS69_VIDEO_MODEL=
# Veo 3.1 Lite and several other models reject the `duration` field with 400.
# Leave false unless you've pinned LABS69_VIDEO_MODEL to one that accepts it.
LABS69_VIDEO_SEND_DURATION=false
# Image generation resolution for nano-banana models: 1k | 2k | 4k.
# Default 1k: it's the only value this 69labs account/tier actually serves —
# 2k/4k return `503 SERVICE_UNAVAILABLE` on submit even though /images/models
# advertises them. 1k is sub-HD (~1024×576 at 16:9, upscaled in the final
# encode). Raise to 2k/4k only after confirming the plan supports it.
# (Other image models — z-image, flux, gpt-image-2, grok — ignore this.)
LABS69_IMAGE_RESOLUTION=1k
# Max CONCURRENT in-flight 69labs jobs per kind (separate from req/min rate
# limits) — the BullMQ PULL cap. Size it to (active keys × per-key cap below)
# so every key's slot pool stays fed; the real cross-process limiter is the
# per-key cap. Enforced by a distributed semaphore, so you can enqueue any
# number of prompts and they pipeline through N at a time.
LABS69_IMAGE_MAX_CONCURRENCY=4
LABS69_VIDEO_MAX_CONCURRENCY=4

# Concurrent in-flight jobs PER KEY — must match your 69labs plan's per-account
# cap PER FEATURE or you'll get `403 Concurrent ... limit reached`. 69labs allows
# 4 for image, fewer for video. Per-feature vars override LABS69_PER_KEY_CONCURRENCY.
LABS69_IMAGE_PER_KEY_CONCURRENCY=4
LABS69_VIDEO_PER_KEY_CONCURRENCY=2
LABS69_PER_KEY_CONCURRENCY=2
# Expected active-key count — only sizes the BullMQ pull cap defaults above.
LABS69_MAX_KEYS=2

# ===== INFRASTRUCTURE =====

# Postgres (REQUIRED) — Supabase.
# App runtime uses the TRANSACTION POOLER (port 6543) for tiny connection
# footprint. Migrations use the DIRECT connection (port 5432) — see README.
# URL-encode any special chars in the password (e.g. @ → %40).
DATABASE_URL=placeholder
# Optional: cap per-process Postgres connections. Default 5 (see packages/db/src/client.ts).
# DB_POOL_MAX=5

# Supabase platform features (Auth admin, Storage, Realtime). Server-only.
# Dashboard → Project Settings → API. SERVICE_ROLE_KEY bypasses RLS — never
# expose it to a browser. Drizzle queries don't need these; only code that
# calls `supabase()` from @emberforge/db does.
SUPABASE_URL=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder
# Public anon key for the web app (Next.js exposes vars prefixed with NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder

# Redis (REQUIRED for BullMQ)
# Local dev: docker run -d -p 6379:6379 redis:7
REDIS_URL=placeholder 

# Cloudflare R2 (REQUIRED — persists every generated asset)
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET=placeholder

# ===== API =====
PORT=8080 
NODE_ENV=development
LOG_LEVEL=info

# Owner id assigned to every project created via the API (auth is off in safe-mode)
DEV_OWNER_ID=placeholder

# ===== RENDER =====
FFMPEG_PATH=placeholder
FFPROBE_PATH=placeholder
RENDER_WORK_DIR=placeholder

# NVENC: on a GPU machine with NVIDIA GPU, set to "true". Otherwise leave false.
NVENC_ENABLED=false

# FX overlays — optional machine-local/mounted FX library, checked BEFORE the
# plates bundled in packages/render/assets. Leave as placeholder to use only the
# bundled assets (the default embers plate ships there, so overlays work without
# this). Point it at a folder to add higher-res or extra plates.
FX_LIBRARY_DIR=placeholder

# Global particle overlay, screen-blended once onto the finished master.
#   CINEMATIC_OVERLAY        embers (default, on) | particles | lightleak | auto | off
#   CINEMATIC_OVERLAY_LEVEL  subtle (default) | medium | heavy  (needs matching plate)
#   CINEMATIC_OVERLAY_ALPHA  screen opacity for the embers plate (default 0.15)
# Set CINEMATIC_OVERLAY=off to disable and restore the fast stream-copy mux.
CINEMATIC_OVERLAY=embers
CINEMATIC_OVERLAY_LEVEL=subtle
CINEMATIC_OVERLAY_ALPHA=0.15

# ----- Render performance knobs (all optional; sensible defaults shown) -----
# Recommended values for a performance-8x (8 vCPU) render machine are shown.
#
# Parallel per-shot FFmpeg processes. Default: min(8, ceil(cpuCount/2)).
# RENDER_SHOT_CONCURRENCY=8
# Parallel mix-segment prep (image Ken Burns encodes + video stream-copies).
# Default 4 (ceil(8 vCPU / 2)). Pair with FFMPEG_INTERMEDIATE_THREADS so
# concurrency × threads ≈ cores (e.g. 4 × 2 = 8). Raising concurrency WITHOUT
# capping threads oversubscribes the scheduler and is slower, not faster.
# RENDER_MIX_CONCURRENCY=4
# Parallel asset downloads during the composite prefetch (pure I/O). Default: 8.
# RENDER_DOWNLOAD_CONCURRENCY=16
# Tier-2 speedup: how many sleep crossfade batch sub-masters to encode at once.
# Batches are independent (only the final join needs them all), so a multi-core
# box can render several in parallel. Each xfade ffmpeg is multi-threaded, so keep
# this modest. Default: 2. Set 1 to restore the old sequential behaviour.
SLEEP_BATCH_CONCURRENCY=2
# Threads PER intermediate encode — applies to BOTH the legacy mixClips path and
# the sleep prep encoders. With many parallel encodes, capping this
# (≈ cores / MIX_CONCURRENCY) stops libx264 oversubscribing the scheduler — a
# quality-neutral speedup (thread count does not change output quality).
# Default: 2. Set 0 to let x264 auto-pick (one thread per core).
# FFMPEG_INTERMEDIATE_THREADS=2
# Preset/CRF for the intermediate (per-segment) encodes. Defaults: veryfast / 20.
# FFMPEG_INTERMEDIATE_PRESET=veryfast
# FFMPEG_INTERMEDIATE_CRF=20
#
# ----- 69labs generation motion (SLEEP / DREAM mode) -----
# How much motion the prompt asks 69labs to bake INTO each generated clip/image.
# 69labs exposes no motion_intensity knob, so this is enforced purely through the
# prompt + negative-prompt text (see packages/prompt-engine/src/motionMode.ts).
#   sleep — motion_intensity 0.05-0.1: locked / micro-dolly only, no parallax,
#           no zoom, no in-clip transitions, objects still. Default; use for all
#           long-form sleep content.
#   dream — motion_intensity 0.1-0.15: one slow pan OR slow push, mild parallax.
# This is separate from the Ken Burns / cross-dissolve motion the renderer adds.
# MOTION_MODE=sleep
#
# ----- Ken Burns (anti-shake) motion -----
# zoompan floors its crop x/y to whole INPUT pixels each frame, so a near-target
# canvas visibly shakes. We render the still oversampled so that floor is
# sub-pixel. Higher = smoother but more CPU/RAM (zoompan is the hottest filter).
# Default: 4 (clamped so 4K caps the rendered long edge at KENBURNS_MAX_RENDER).
# Kept at 4 — this is the anti-shimmer quality knob; lowering it trades visible
# motion quality for speed, which we are NOT doing (speed comes from fewer passes).
# KENBURNS_OVERSAMPLE=4
# Cap on the oversampled long edge (keeps 4K targets sane). Default: 8192.
# KENBURNS_MAX_RENDER=8192
# Zoom ceiling for the Ken Burns push (1.10 = a subtle 10% move). Smaller = less
# travel = even less chance of shake. Sleep stories override this to ~1.02.
# KENBURNS_MAX_ZOOM=1.10
# Optional output supersample + lanczos downscale for the most demanding footage
# (extra anti-aliasing of residual sub-pixel stepping). 1 = off. Default: 1.
# KENBURNS_SUPERSAMPLE=1
#
# ----- Global cinematic grade -----
# Applies the "premium documentary" look (warm highlights, filmic contrast,
# gentle vignette) ONCE to the finished master so every scene matches. This
# requires a real final encode (it opts out of the instant stream-copy mux).
# Set false for fast review renders that just mux audio in seconds.
# CINEMATIC_GRADE=true
# Scale the whole grade 0..1 (subtler ↔ stronger). Default: 1.
# CINEMATIC_GRADE_STRENGTH=1
#
# ----- Ember / light-leak overlay -----
# A subtle warm layer screen-blended over the whole master (atmosphere, NOT
# flames covering the screen). PENDING: parked for now — defaults to 'off'.
# Set CINEMATIC_OVERLAY=particles (or any mode below) to switch it back on.
# Modes:
#   particles asset-free synthetic FIRE EMBERS rising from the bottom
#   lightleak asset-free drifting warm light-leak wash
#   auto      use a real ember plate from the FX library if present, else fall
#             back to synthetic particles
#   embers    force the FX ember plate (FX.embers[LEVEL]); if missing, particles
#   off       (default) disable the overlay entirely
# CINEMATIC_OVERLAY=off
# Warm colour shared by all synthetic modes (FFmpeg 0xRRGGBB). Default: 0xFF7A1E.
# CINEMATIC_OVERLAY_COLOR=0xFF7A1E
# Screen-blend opacity 0..1. Defaults: 0.60 particles, 0.10 light-leak, 0.15 plate.
# CINEMATIC_OVERLAY_ALPHA=0.60
#
# --- Rising fire embers (CINEMATIC_OVERLAY=particles, the default) ---
# Rise speed (fraction of frame per frame; bigger = faster). Default: 0.012.
# CINEMATIC_EMBER_SPEED=0.012
# Density — fraction of pixels lit as embers (bigger = more). Default: 0.006.
# CINEMATIC_EMBER_AMOUNT=0.006
#
# --- Synthetic light-leak tuning (CINEMATIC_OVERLAY=lightleak) ---
# Shape: linear (diagonal sweep, default) or radial (centred bloom).
# CINEMATIC_OVERLAY_TYPE=linear
# Drift speed — smaller = slower sweep. Default: 0.004.
# CINEMATIC_OVERLAY_SPEED=0.004
#
# --- Ember plate (CINEMATIC_OVERLAY=embers / auto with asset present) ---
# Plate level: subtle | medium | heavy.
# CINEMATIC_OVERLAY_LEVEL=subtle
#
# BURN_SUBTITLES: false (default) ships subs as a sidecar. The final pass only
# stream-copies the master (a ~2-hour render finishes in seconds) when the grade
# AND the overlay are off AND subs aren't burned; otherwise it re-encodes. Set
# true to burn subs into the pixels (drawn ON TOP of the grade + overlay, so they
# stay readable).
# BURN_SUBTITLES=false
# Preset/CRF for the FINAL encode — used whenever the final pass re-encodes
# (grade on or subtitles burned). Defaults: medium / 20.
# Tier-1 speedup: veryfast is ~2-3x faster than medium on the single biggest stage
# (the grade+ember final encode), slightly softer at the same CRF — fine for sleep.
FFMPEG_X264_PRESET=veryfast
# FFMPEG_X264_CRF=20

# ----- 69labs asset-generation concurrency -----
# NOTE: 69labs image and video now run on separate queues/workers (labsImage,
# labsVideo). Each worker's BullMQ concurrency is its per-kind cap above
# (LABS69_IMAGE_MAX_CONCURRENCY / LABS69_VIDEO_MAX_CONCURRENCY), so the old
# single combined LABS_CONCURRENCY knob is no longer read.
# Each active job buffers a download in memory, so peak RAM on the `workers`
# machine ≈ (IMAGE_MAX + VIDEO_MAX) × clip size — size the VM to match (see
# infra/fly/sleepytool.fly.toml). Raise the caps ONLY if you also bump RAM.

# ----- Web frontend: API base URL -----
# How the Next.js UI reaches the API. Default (unset) = '/api', i.e. same-origin
# Route Handlers — correct for both `pnpm stack:dev` and a standard deploy where
# the web app serves its own /api/*.
# Set this ONLY when the API lives on a SEPARATE origin in production (or to point
# a local UI at a remote backend). Use the full origin, no trailing slash:
#   NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
# It is inlined at build time and must live in the web build env (apps/web/.env
# or your host's build settings), so set it BEFORE `next build`.
# NEXT_PUBLIC_API_BASE_URL=
